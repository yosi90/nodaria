# Copiar a .env y ajustar. .env no se versiona.
NODE_ENV=development

# Solo escucha en local: Cloudflare Tunnel publica nodaria-api.yosiftware.es -> 127.0.0.1:5003
HOST=127.0.0.1
PORT=5003

# SQL Server Express con autenticación de Windows (la identidad del proceso)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=Nodaria
DB_DRIVER=ODBC Driver 18 for SQL Server

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=https://nodaria.yosiftware.es,https://yosiftware-nodaria.web.app,https://yosiftware-nodaria.firebaseapp.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Firebase Authentication
FIREBASE_PROJECT_ID=yosiftware-nodaria
# Ruta a la cuenta de servicio de Firebase Admin (fuera del repo o en api/secrets/)
GOOGLE_APPLICATION_CREDENTIALS=

# Tamaño máximo de un proyecto (JSON) en bytes
PROJECT_MAX_BYTES=20971520

# Notificapp: avisos de mensajes nuevos (credencial de emisor del plugin nodaria-api) y
# credencial externa con la que Notificapp llama al panel (/notificapp/v1/*).
# Ambos archivos contienen solo el token y viven fuera de Git (api/.runtime/).
NOTIFICAPP_URL=https://notificapp-api.yosiftware.es
NOTIFICAPP_SENDER_TOKEN_FILE=.runtime/notificapp-sender.token
NOTIFICAPP_UPSTREAM_TOKEN_FILE=.runtime/notificapp-upstream.token

# msnodesqlv8 ejecuta cada consulta en el pool de hilos de libuv (4 por defecto)
UV_THREADPOOL_SIZE=16

# Carpeta de logs con rotación diaria (vacío: salida estándar). La fija ops/run-api.ps1.
LOG_DIR=
