{
  "name": "nodaria-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/auth/yosiftware-tokens.mjs','dist/auth/yosiftware-tokens.mjs')\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:qa": "tsx watch --env-file=.env.dev src/server.ts",
    "enlazar-cuenta": "tsx --env-file-if-exists=.env src/tools/cli.ts enlazar-cuenta",
    "anunciar": "tsx --env-file-if-exists=.env src/tools/cli.ts anunciar"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "msnodesqlv8": "5.5.0",
    "mssql": "12.7.2",
    "openai": "7.30.1",
    "pino-roll": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.1",
    "firebase-tools": "15.32.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "msnodesqlv8@5.5.0": true
  }
}
