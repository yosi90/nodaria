{
  "name": "nodaria-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only auth --project demo-nodaria \"vitest run test/firebase-emulator.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "firebase-admin": "14.5.0",
    "msnodesqlv8": "5.5.0",
    "mssql": "12.7.2",
    "pino-roll": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.1",
    "firebase-tools": "15.32.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "msnodesqlv8@5.5.0": true
  }
}
